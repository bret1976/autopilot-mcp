# Required in production. Used to sign buyer MCP tokens.
MCP_ISSUER_SECRET=change-me-to-a-long-random-string

# Public origin of this service (no trailing slash).
PUBLIC_BASE_URL=https://your-service.up.railway.app

# Admin mint desk. Required to open /admin and mint buyer URLs.
ADMIN_SECRET=change-me-admin-secret

# Optional. Where buyer JSON + leads + media live (use a volume in production).
DATA_DIR=./data

# Optional. Override listen port (Railway sets PORT).
PORT=8080

# Do not set MOCK_MODE. Mock is a per-call flag on run_autopilot for tests only.

# Comma-separated buyer ids or full tokens to reject at /mcp.
# REVOKED_KEYS=studio-alpha,buyer_id.123.0.abc

# Stripe Checkout (required for public agent/human card sales).
# STRIPE_SECRET_KEY=sk_test_... or sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (endpoint: /api/stripe/webhook, event: checkout.session.completed)
# STRIPE_PRICE_ID=price_...       (one-time $997 USD on the same Stripe account)
# STRIPE_PAYMENT_LINK=            (optional mention-only link; Checkout Session is the gate)

# Run Guard (backend pack). Soft-blocks duplicate live publishes within the window.
# RUN_GUARD_BLOCK=1
# RUN_GUARD_WINDOW_SEC=86400
# RUN_GUARD_LEDGER=/data/run_guard_ledger.json
